<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_analytic" model="ir.ui.view">
        <field name="name">res.company.form.inherit.analytic</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="analytic_account_default_id" 
                       placeholder="Default Analytic Account for Invoices"/>
            </xpath>
        </field>
    </record>
</odoo>