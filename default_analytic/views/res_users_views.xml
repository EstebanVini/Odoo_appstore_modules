<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_default_analytic" model="ir.ui.view">
        <field name="name">res.users.form.inherit.default.analytic</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="default_analytic_account_id" 
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Set Default Analytic Account for User Invoices"
                       context="{'company_id': company_id}"/> 
                       </xpath>
        </field>
    </record>
</odoo>